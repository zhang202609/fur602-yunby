# 可选功能：UA2F
# 源文件由 doc/diy/diy-part1.sh 从 https://github.com/Zxilly/UA2F 克隆到 package/UA2F
#
# 注意：UA2F 依赖 netfilter queue，必须关闭 flow offloading（主 config 中已设置
# CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH=y），否则规则不生效。
#
# 不需要时把下面几行注释掉即可，无需改别的地方。

CONFIG_PACKAGE_ua2f=y
CONFIG_PACKAGE_iptables-mod-nfqueue=y
CONFIG_PACKAGE_kmod-ipt-nfqueue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
